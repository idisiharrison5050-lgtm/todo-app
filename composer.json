{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "idisiharrison5050-lgtm/todo-app",
    "type": "project",
    "description": "Cross-platform task and reminder application backend.",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\": "database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "dev": "php artisan serve"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
